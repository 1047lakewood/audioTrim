{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schemas/refs/heads/master/schema/tauri-conf-2.schema.json",
  "productName": "Audio Trimmer",
  "version": "1.0.0",
  "identifier": "com.audiotrimmer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Trimmer",
        "width": 1200,
        "height": 175,
        "minWidth": 800,
        "minHeight": 125,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
